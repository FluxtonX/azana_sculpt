rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper to check if the current user is a coach
    function isCoach() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    // --- Users Collection & Subcollections (including progress, mealPlans, etc.) ---
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isCoach();
      
      // Matches all subcollections recursively to prevent PERMISSION_DENIED on sub-docs
      match /{allChildren=**} {
        allow read, write: if isOwner(userId) || isCoach();
      }
    }

    // --- Programs Collection ---
    match /programs/{programId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
      
      match /{allChildren=**} {
        allow read: if isAuthenticated();
        allow write: if isCoach();
      }
    }

    // --- Completed Workouts Collection ---
    match /completed_workouts/{workoutId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCoach());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCoach());
    }

    // --- Chats Collection & Subcollections (Messages) ---
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // --- Payment Requests Collection ---
    match /payment_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // --- Weight Logs Collection ---
    match /weight_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCoach());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCoach());
    }

    // --- Assignments Collection ---
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (resource.data.clientId == request.auth.uid || isCoach());
      allow create: if isCoach();
      allow update: if isAuthenticated() && (resource.data.clientId == request.auth.uid || isCoach());
      allow delete: if isCoach();
    }
  }
}
