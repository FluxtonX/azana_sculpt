rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /meal_plans/{clientId}/{fileName} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.size <= 25 * 1024 * 1024;

      allow delete: if signedIn();
    }
  }
}
